# ==============================================================================
# MOODIFY BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Sao chép file này thành .env trên môi trường Dev hoặc Production và điền thông tin tương ứng.
# ==============================================================================

# ===============================
# APPLICATION / SERVER
# ===============================
SERVER_PORT=8080
SPRING_DOCKER_COMPOSE_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===============================
# MYSQL DATABASE
# ===============================
# [DEV - Local]:
DATABASE_SOURCE_URL=jdbc:mysql://127.0.0.1:3306/moodify?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# [PROD - Server]: Bỏ comment và điền thông tin production
# DATABASE_SOURCE_URL=jdbc:mysql://<PROD_MYSQL_HOST>:3306/moodify?useSSL=true&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
# DATABASE_USERNAME=<PROD_MYSQL_USER>
# DATABASE_PASSWORD=<PROD_MYSQL_PASSWORD>

# ===============================
# MONGODB DATABASE
# ===============================
# Tên Database chính thức
MONGODB_DATABASE=music_streaming

# [LỰA CHỌN 1: DEV - Cục bộ trên máy tính (Đang kích hoạt)]
MONGODB_URI=mongodb://127.0.0.1:27017/music_streaming

# [LỰA CHỌN 2: PROD - VPS riêng (Ví dụ Ubuntu VPS có user/pass)]:
# MONGODB_URI=mongodb://<DB_USER>:<DB_PASSWORD>@<VPS_IP>:27017/music_streaming?authSource=admin

# ===============================
# SECURITY & JWT
# ===============================
JWT_SECRET=change-this-to-a-very-long-secret-key-for-hs256-token
JWT_ACCESS_TOKEN_EXPIRATION=1200000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
